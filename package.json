{
  "name": "@danielcanfly/daniel-commander",
  "version": "0.1.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Minimal headless MCP computer-control core for Daniel Commander.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:p2": "npm run build && node dist/test/p2-core.integration.js",
    "test": "npm run test:p2 && npm run test:p3 && npm run test:p4 && npm run test:p5 && npm run test:p6 && npm run test:p7 && npm run test:original-p8",
    "test:p3": "npm run build && node dist/test/p3-mcp.integration.js",
    "test:p4": "npm run build && node dist/test/p4-policy.integration.js",
    "test:p5": "node scripts/test-p5.mjs",
    "test:p6": "npm run build && node dist/test/p6-public.integration.js",
    "doctor": "./scripts/doctor.sh",
    "test:p7": "npm run build && node dist/test/p7-release.integration.js",
    "test:original-p8": "npm run build && node dist/test/original-p8-lifecycle.integration.js",
    "release:preflight": "./scripts/release-preflight.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@vscode/ripgrep": "^1.15.9",
    "fastest-levenshtein": "^1.0.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
