{
  "name": "localbridge-mcp",
  "version": "0.2.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Minimal headless MCP computer-control core for LocalBridge MCP.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:core": "npm run build && node dist/test/core.integration.js",
    "test": "npm run test:core && npm run test:mcp && npm run test:policy && npm run test:runtime && npm run test:public && npm run test:release && npm run test:lifecycle && npm run test:final",
    "test:mcp": "npm run build && node dist/test/mcp-surface.integration.js",
    "test:policy": "npm run build && node dist/test/policy.integration.js",
    "test:runtime": "node scripts/test-runtime.mjs",
    "test:public": "npm run build && node dist/test/public-surface.integration.js",
    "doctor": "./scripts/doctor.sh",
    "test:release": "npm run build && node dist/test/release.integration.js",
    "test:lifecycle": "npm run build && node dist/test/lifecycle.integration.js",
    "release:preflight": "./scripts/release-preflight.sh",
    "test:final": "npm run build && node dist/test/final-qualification.integration.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@vscode/ripgrep": "^1.15.9",
    "fastest-levenshtein": "^1.0.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
